{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "searchable",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  // Staging answers on its workers.dev host and on staging.searchable.pk (NOINDEX keeps both out of search engines).
  "routes": [{ "pattern": "staging.searchable.pk", "custom_domain": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Paid: 20M log events a month included, so keep every event for now.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true }
  },
  // D1 lives in one region (APAC hint); Smart Placement runs the Worker next to it.
  "placement": { "mode": "smart" },
  // Images: the existing bucket behind img.searchable.pk, written through this binding (src/lib/storage.ts).
  // Page cache: vinext's Response Store keeps rendered pages in R2 with a SQLite Durable Object as the index, one
  // copy worldwide, so a page renders once per revalidation window instead of once per data centre.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "searchable-images" },
    { "binding": "CACHE_BODIES", "bucket_name": "searchable-page-cache" }
  ],
  "durable_objects": { "bindings": [{ "name": "CACHE_METADATA", "class_name": "CacheMetadata" }] },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "ResponseStoreBinding": { "type": "worker", "cache": { "enabled": true } },
    "CacheMetadata": { "type": "durable-object", "storage": "sqlite" }
  },
  // The database: D1 (ADR-45). Migrations live in migrations/ and are applied with wrangler d1 migrations apply.
  "d1_databases": [{ "binding": "DB", "database_name": "searchable-staging", "database_id": "7185c5fd-a1f9-45e1-8f91-71eae5544637", "migrations_dir": "migrations" }],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "searchable_events_staging" }],
  // Public configuration. Secrets (BETTER_AUTH_SECRET, ADMIN_API_KEY, CRON_SECRET, RESEND_API_KEY,
  // RESEND_WEBHOOK_SECRET, INDEXNOW_KEY, ...) are set with `wrangler secret put`, never here.
  // HEAVY_COMPUTE=1: this plan may spend CPU inside a request (image resizing, social cards); unset on the free plan.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://staging.searchable.pk",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE8eaoAcHkRopZwk",
    "CF_ACCOUNT_ID": "3e02be964b5996062caa1d80a651a838",
    "ANALYTICS_DATASET": "searchable_events_staging",
    "NEXT_PUBLIC_SITE_NAME": "Searchable",
    "BETTER_AUTH_URL": "https://staging.searchable.pk",
    "STORAGE_PROVIDER": "r2",
    "R2_PUBLIC_URL": "https://img.searchable.pk",
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "Searchable <daily@searchable.pk>",
    "HEAVY_COMPUTE": "1",
    "NOINDEX": "1",
    "JOBS_DISABLED": "1"
  },
  "env": {
    "production": {
      "name": "searchable-production",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "searchable-images" },
        { "binding": "CACHE_BODIES", "bucket_name": "searchable-production-page-cache" }
      ],
      "durable_objects": { "bindings": [{ "name": "CACHE_METADATA", "class_name": "CacheMetadata" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "searchable", "database_id": "1a91bc6d-7826-499d-b677-e5ad6bd1e18b", "migrations_dir": "migrations" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "searchable_events" }],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://searchable.pk",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE8ebJNuDtougfh2",
        "CF_ACCOUNT_ID": "3e02be964b5996062caa1d80a651a838",
        "ANALYTICS_DATASET": "searchable_events",
        "NEXT_PUBLIC_SITE_NAME": "Searchable",
        "BETTER_AUTH_URL": "https://searchable.pk",
        "STORAGE_PROVIDER": "r2",
        "R2_PUBLIC_URL": "https://img.searchable.pk",
        "EMAIL_FROM": "Searchable <daily@searchable.pk>",
        "HEAVY_COMPUTE": "1",
        "EMAIL_PROVIDER": "resend"
      },
      // The live site (cutover 2026-09-19, docs/CUTOVER.md). The custom domain is the apex; www is a 301 Redirect
      // Rule on the zone. No workers.dev host in production, so there is one canonical origin.
      "workers_dev": false,
      "routes": [{ "pattern": "searchable.pk", "custom_domain": true }]
    }
  }
}
