{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "searchable",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Free-plan logging (200k events a day, 3 days); sampled so a busy day stays inside it.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 0.2 },
    "traces": { "enabled": true }
  },
  // The database is remote (Supabase in Tokyo through Hyperdrive until Phase 2), so run the Worker near it.
  "placement": { "mode": "smart" },
  // Images: the existing bucket behind img.searchable.pk. Written through this binding (src/lib/storage.ts).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "searchable-images" }],
  // Phase 1: the existing Supabase database through Hyperdrive (pooled next to it, query cache off).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d6577f9e3cc9465cb479327ccabe3682" }],
  // Public configuration. Secrets (BETTER_AUTH_SECRET, ADMIN_API_KEY, CRON_SECRET, RESEND_API_KEY,
  // RESEND_WEBHOOK_SECRET, INDEXNOW_KEY, ...) are set with `wrangler secret put`, never here.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://staging.searchable.pk",
    "NEXT_PUBLIC_SITE_NAME": "Searchable",
    "BETTER_AUTH_URL": "https://staging.searchable.pk",
    "STORAGE_PROVIDER": "r2",
    "R2_PUBLIC_URL": "https://img.searchable.pk",
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "Searchable <daily@searchable.pk>",
    "NOINDEX": "1",
    "JOBS_DISABLED": "1"
  },
  "env": {
    "production": {
      "name": "searchable-production",
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "searchable-images" }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d6577f9e3cc9465cb479327ccabe3682" }],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://searchable.pk",
        "NEXT_PUBLIC_SITE_NAME": "Searchable",
        "BETTER_AUTH_URL": "https://searchable.pk",
        "STORAGE_PROVIDER": "r2",
        "R2_PUBLIC_URL": "https://img.searchable.pk",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "Searchable <daily@searchable.pk>"
      }
    }
  }
}
