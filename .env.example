# ── Database ─────────────────────────────────────────────────────────────
# Local (default): embedded Postgres via PGlite, stored in ./.data/pglite
DATABASE_URL=pglite://./.data/pglite
# Production (Supabase):
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Searchable

# ── Auth (better-auth) ───────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://localhost:3000

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@searchable.pk
SEED_ADMIN_PASSWORD=searchable-admin-123

# ── Email ────────────────────────────────────────────────────────────────
# local: writes .eml files into ./.data/outbox   |  resend: uses RESEND_API_KEY
EMAIL_PROVIDER=local
EMAIL_FROM="Searchable <daily@searchable.pk>"
RESEND_API_KEY=

# ── Optional (production) ────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
TURNSTILE_SECRET_KEY=
