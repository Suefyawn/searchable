# ── Database ─────────────────────────────────────────────────────────────
# Local (default): embedded Postgres via PGlite, stored in ./.data/pglite
DATABASE_URL=pglite://./.data/pglite
# Production (Supabase):
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Searchable

# ── Auth (better-auth) ───────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
# Cloudflare Turnstile on the public forms and login (ADR-47). Leave both unset locally: forms then skip the check.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin account created by `npm run db:seed`. The default password only works against local PGlite;
# seeding any other database without SEED_ADMIN_PASSWORD set refuses to run.
SEED_ADMIN_EMAIL=admin@searchable.pk
SEED_ADMIN_PASSWORD=searchable-admin-123
# reference: locations, categories, entities, synonyms, data series, tools, admin (production) | sample: plus sample articles and businesses (default, local)
SEED_MODE=sample

# ── Email ────────────────────────────────────────────────────────────────
# local: writes .eml files into ./.data/outbox   |  resend: uses RESEND_API_KEY
EMAIL_PROVIDER=local
EMAIL_FROM="Searchable <daily@searchable.pk>"
RESEND_API_KEY=
# Resend > Webhooks > endpoint https://<site>/api/webhooks/resend, event email.received; signing secret whsec_...
RESEND_WEBHOOK_SECRET=
# Send budget (docs/FREE-TIER.md). Defaults fit Resend Free: 100/day, 3,000/month, 15/day kept for transactional mail.
EMAIL_DAILY_CAP=95
EMAIL_MONTHLY_CAP=2900
EMAIL_BULK_RESERVE=15

# ── Images ───────────────────────────────────────────────────────────────
# local (default): public/uploads  |  r2: Cloudflare R2 (recommended, free egress)  |  supabase: Supabase Storage (metered)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=searchable-media
# Custom domain on the bucket, cached by Cloudflare, e.g. https://img.searchable.pk
R2_PUBLIC_URL=
# Only for STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ── Analytics (optional; off when unset). No PostHog or Sentry: docs/FREE-TIER.md ──
# Microsoft Clarity project id (loads after interaction, skipped on admin routes)
NEXT_PUBLIC_CLARITY_ID=

# ── Scheduled publishing ─────────────────────────────────────────────────
# Vercel (daily crons) and the cron-job.org pinger (/api/cron/publish every 5 minutes) send
# "authorization: Bearer <CRON_SECRET>". Leave empty locally.
CRON_SECRET=

# ── Monetization (all optional; off when unset) ─────────────────────────────
# Google AdSense publisher id (ca-pub-…) and slot ids from the AdSense dashboard. Leave empty locally.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
# Where invoice/payment notifications and pitches go
BILLING_EMAIL=billing@searchable.pk
EDITORIAL_EMAIL=editorial@searchable.pk
# Number claimants message "CLAIM <code>" from their listed phone (ownership claims, phone method)
CLAIM_WHATSAPP_NUMBER=+92 300 0000000

# ── Openly licensed photos (Openverse). Optional: raises the anonymous 200/day limit.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# IndexNow key (32 hex chars) for instant indexing on Bing/Yandex; served at /indexnow-key.txt
INDEXNOW_KEY=

# Admin API (docs/ADMIN-API.md): Authorization: Bearer <key>; 64 hex chars from openssl rand -hex 32
ADMIN_API_KEY=

# Search Console (HTML tag method: the content value of the meta tag) and Bing Webmaster (msvalidate.01)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Manual payments (shown on invoices). Leave empty and billing emails the details by hand.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_TITLE=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_IBAN=
PAYMENT_JAZZCASH=
PAYMENT_EASYPAISA=
