{
  // The scheduler (migration Phase 4, ADR-46): Cron Triggers that call the site's own cron endpoints through a
  // service binding, and the fuel-price Workflow for the 1st and 16th. Deploy: npm run deploy:scheduler.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "searchable-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "logs": { "enabled": true } },
  "triggers": { "crons": ["*/5 * * * *", "15 * * * *", "30 2 * * *", "0 10,13 1,16 * *"] },
  "services": [{ "binding": "SITE", "service": "searchable" }],
  "workflows": [{ "name": "searchable-fuel-price", "binding": "FUEL", "class_name": "FuelPriceWorkflow" }],
  "vars": { "SITE_URL": "https://searchable.sooviaan.workers.dev" },
  "env": {
    "production": {
      "name": "searchable-scheduler-production",
      "services": [{ "binding": "SITE", "service": "searchable-production" }],
      "workflows": [{ "name": "searchable-fuel-price-production", "binding": "FUEL", "class_name": "FuelPriceWorkflow" }],
      "vars": { "SITE_URL": "https://searchable.pk" },
      "triggers": { "crons": ["*/5 * * * *", "15 * * * *", "30 2 * * *", "0 10,13 1,16 * *"] }
    }
  }
}
