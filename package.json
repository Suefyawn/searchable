{
  "name": "searchable",
  "version": "0.1.0",
  "private": true,
  "description": "Searchable.pk, Pakistan's information platform. Find what you need. Know what matters.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-images": "tsx scripts/seed-images.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "preflight": "tsx scripts/preflight.ts",
    "search:reindex": "tsx scripts/reindex.ts",
    "seed:backlog": "tsx scripts/seed-backlog.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@electric-sql/pglite": "^0.5.8",
    "@jsquash/webp": "^1.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "resend": "^6.28.0",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.3.1",
    "vinext": "^1.0.0-beta.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
