{
  // Local development (`npm run dev`): the same bindings as wrangler.jsonc against wrangler's local D1 and R2, without
  // the Response Store Durable Object, which vinext dev cannot host (pages are served uncached in development anyway).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "searchable",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "searchable-images" }],
  "images": { "binding": "IMAGES" },
  "d1_databases": [{ "binding": "DB", "database_name": "searchable-staging", "database_id": "7185c5fd-a1f9-45e1-8f91-71eae5544637", "migrations_dir": "migrations" }]
}
